# ── Required ──────────────────────────────────────────────────────────────────
# Backboard.io (AI orchestration, LLM access, persistent memory)
# Sign up at: https://backboard.io
BACKBOARD_API_KEY=...

# ElevenLabs (voice synthesis)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=...

# ── Optional: full video mode ─────────────────────────────────────────────────
# D-ID (talking-head video generation)
# Get yours at: https://www.d-id.com/
# Without this, the app runs in audio-only mode.
D_ID_API_KEY=...

# A publicly accessible image URL of Mike Ehrmantraut (used by D-ID).
# Must be a direct image link (.jpg/.png) with a clearly visible face.
MIKE_IMAGE_URL=https://...

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3000

# The public URL this server is reachable at (D-ID needs to fetch audio from here).
# For local dev with ngrok: https://abc123.ngrok.io
# For Railway/Render/etc: your deployed URL
PUBLIC_URL=http://localhost:3000

# ── Optional: skip Mike assistant re-creation on restart ──────────────────────
# On first run the server creates a "Mike Ehrmantraut" assistant in Backboard
# and prints its ID in the logs. Paste it here to reuse it across restarts.
# BACKBOARD_ASSISTANT_ID=asst_...

# ── Optional ElevenLabs voice override ────────────────────────────────────────
# Default is "Arnold" (VR6AewLTigWG4xSOukaG) — deep, gravelly, authoritative.
# Search ElevenLabs' community voice library for "Mike Ehrmantraut" or
# "Jonathan Banks" for a more accurate match.
# ELEVENLABS_VOICE_ID=VR6AewLTigWG4xSOukaG
